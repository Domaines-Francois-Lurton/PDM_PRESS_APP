rules_version = '2';

// Règles de sécurité Firestore : à copier dans la console Firebase
// (Firestore Database > Règles > coller > Publier).
// Seul le compte technique partagé peut lire et écrire les dossiers.
// ⚠️ L'e-mail doit être identique à AUTH_EMAIL dans src/config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeam() {
      return request.auth != null
        && request.auth.token.email == "yvain.ramousse@francoislurton.com";
    }
    match /dossiers/{dossierId} {
      allow read, write: if isTeam();
    }
    // Tout le reste est interdit par défaut.
  }
}
